{
  "name": "compra-car",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "22.x",
    "pnpm": ">=10.0.0 <11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@compra-car/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "pricing:dry-run": "pnpm --filter @compra-car/pricing-dry-run dry-run",
    "pricing:msrp:reconcile": "pnpm --filter @compra-car/core exec tsx ../../scripts/data-refresh/run-msrp-history-import.ts",
    "specs:dry-run": "pnpm --filter @compra-car/core exec tsx ../../scripts/data-refresh/run-vehicle-specs-dry-run.ts",
    "specs:reconcile": "pnpm --filter @compra-car/core exec tsx ../../scripts/data-refresh/run-vehicle-specs-reconciliation.ts",
    "pricing:snapshot:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pricing/tests/pricing-snapshot-scripts.test.ps1",
    "start": "pnpm --filter @compra-car/web start",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "agent:new-products:dry-run": "pnpm --filter @compra-car/agents dry-run",
    "agent:brand-connector:dry-run": "pnpm --filter @compra-car/agents exec tsx brand-connector-cli.ts",
    "agent:model-year:dry-run": "pnpm --filter @compra-car/agents exec tsx model-year-cli.ts",
    "agent:spec-source:dry-run": "pnpm --filter @compra-car/agents exec tsx spec-source-cli.ts",
    "agent:spec-source:replay": "pnpm --filter @compra-car/agents exec tsx document-intelligence-cli.ts",
    "agent:spec-source:benchmark": "pnpm --filter @compra-car/agents exec tsx document-intelligence-cli.ts"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "prettier": "3.9.5",
    "turbo": "2.10.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0"
  }
}
