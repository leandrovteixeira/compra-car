# Supabase Auth no browser e no SSR. A publishable key (ou anon key legada)
# é pública por definição e nunca deve ser substituída por secret/service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Runtime do servidor. Nunca use NEXT_PUBLIC_ para estas credenciais.
SUPABASE_URL=
SUPABASE_SERVER_KEY=

# Provider real do Import Engine (server-only). One-shot sem config permanece fake;
# segmented exige IMPORT_EXTRACTION_PROVIDER=openai explicitamente.
IMPORT_EXTRACTION_PROVIDER=
IMPORT_EXTRACTION_MODE=one_shot
OPENAI_API_KEY=
OPENAI_IMPORT_MODEL=
OPENAI_IMPORT_TIMEOUT_MS=480000
OPENAI_IMPORT_DIAGNOSTICS=0
RUN_OPENAI_IMPORT_SMOKE=0
OPENAI_IMPORT_SMOKE_BATCH_ID=
RUN_SEGMENTED_OPENAI_IMPORT_SMOKE=0
RUN_OPENAI_SCHEMA_PROBE=0

# Testes de integração opt-in e somente leitura.
SUPABASE_INTEGRATION_URL=
SUPABASE_INTEGRATION_SERVER_KEY=
SUPABASE_INTEGRATION_VEHICLE_IDS=
