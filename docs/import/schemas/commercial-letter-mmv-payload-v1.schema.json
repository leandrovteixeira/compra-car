{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compra.car/schemas/commercial-letter-mmv-payload-v1.schema.json",
  "title": "Compra Car commercial letter MMV payload v1",
  "description": "Versioned, editable preview for exactly one MMV found in a commercial letter.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "mmv",
    "productMatch",
    "commercialPeriod",
    "publicPrice",
    "policies",
    "offers",
    "promotionPlan",
    "issues",
    "overallConfidence",
    "validation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "commercial-letter/mmv-payload/1"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "mmv": {
      "$ref": "#/$defs/mmv"
    },
    "productMatch": {
      "$ref": "#/$defs/productMatch"
    },
    "commercialPeriod": {
      "$ref": "#/$defs/commercialPeriod"
    },
    "publicPrice": {
      "$ref": "#/$defs/publicPrice"
    },
    "policies": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/policy"
      }
    },
    "offers": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/offer"
      }
    },
    "promotionPlan": {
      "$ref": "#/$defs/promotionPlan"
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "overallConfidence": {
      "$ref": "#/$defs/confidence"
    },
    "validation": {
      "$ref": "#/$defs/validation"
    }
  },
  "$defs": {
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "band", "rationale"],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "band": {
          "enum": ["high", "medium", "low"]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentPage", "excerpt", "blockKey"],
      "properties": {
        "documentPage": {
          "type": "integer",
          "minimum": 1
        },
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "blockKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "region": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["pageWidth", "pageHeight", "x", "y", "width", "height"],
              "properties": {
                "pageWidth": { "type": "number", "exclusiveMinimum": 0 },
                "pageHeight": { "type": "number", "exclusiveMinimum": 0 },
                "x": { "type": "number", "minimum": 0 },
                "y": { "type": "number", "minimum": 0 },
                "width": { "type": "number", "exclusiveMinimum": 0 },
                "height": { "type": "number", "exclusiveMinimum": 0 }
              }
            }
          ]
        }
      }
    },
    "fieldMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "confidence", "evidence"],
      "properties": {
        "origin": {
          "enum": ["source", "operator", "system"]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "annotatedString": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "meta"],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "meta": {
          "$ref": "#/$defs/fieldMeta"
        }
      }
    },
    "annotatedNullableString": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "meta"],
      "properties": {
        "value": {
          "type": ["string", "null"],
          "maxLength": 2000
        },
        "meta": {
          "$ref": "#/$defs/fieldMeta"
        }
      }
    },
    "annotatedDate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "meta"],
      "properties": {
        "value": {
          "type": "string",
          "format": "date"
        },
        "meta": {
          "$ref": "#/$defs/fieldMeta"
        }
      }
    },
    "annotatedInteger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "meta"],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 0
        },
        "meta": {
          "$ref": "#/$defs/fieldMeta"
        }
      }
    },
    "annotatedMoney": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency", "meta"],
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]{2}$"
        },
        "currency": {
          "const": "BRL"
        },
        "meta": {
          "$ref": "#/$defs/fieldMeta"
        }
      }
    },
    "annotatedPercentage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "meta"],
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        "unit": {
          "enum": ["percent", "decimal_rate"]
        },
        "meta": {
          "$ref": "#/$defs/fieldMeta"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "originalFileName",
        "sourceRowNumber",
        "primaryPage",
        "applicablePages",
        "applicableBlockKeys",
        "fullApplicableBlockRead",
        "inheritedRulePages"
      ],
      "properties": {
        "originalFileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sourceRowNumber": {
          "type": "integer",
          "minimum": 1
        },
        "primaryPage": {
          "type": "integer",
          "minimum": 1
        },
        "applicablePages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "applicableBlockKeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          }
        },
        "fullApplicableBlockRead": {
          "type": "boolean"
        },
        "inheritedRulePages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "mmv": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brand", "model", "version", "modelYear", "productionYear", "externalCodes"],
      "properties": {
        "brand": { "$ref": "#/$defs/annotatedString" },
        "model": { "$ref": "#/$defs/annotatedString" },
        "version": { "$ref": "#/$defs/annotatedString" },
        "modelYear": { "$ref": "#/$defs/annotatedNullableString" },
        "productionYear": { "$ref": "#/$defs/annotatedNullableString" },
        "externalCodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/annotatedString" }
        },
        "variantRestrictions": {
          "type": "array",
          "items": { "$ref": "#/$defs/annotatedString" }
        }
      }
    },
    "productCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productId", "displayName", "matchMethod", "score"],
      "properties": {
        "productId": { "type": "integer", "minimum": 1 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 500 },
        "matchMethod": {
          "enum": ["exact_business_key", "external_code", "normalized_tokens", "manual"]
        },
        "score": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "productMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "selectedProductId", "selectedBy", "candidates", "expectedProductFingerprint", "issueIds"],
      "properties": {
        "status": {
          "enum": ["unmatched", "ambiguous", "suggested", "confirmed"]
        },
        "selectedProductId": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "selectedBy": {
          "enum": ["none", "system", "operator"]
        },
        "candidates": {
          "type": "array",
          "maxItems": 10,
          "items": { "$ref": "#/$defs/productCandidate" }
        },
        "expectedProductFingerprint": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "issueIds": { "$ref": "#/$defs/issueIds" }
      }
    },
    "commercialPeriod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["competence", "kind", "startsOn", "endsOn", "timezone", "issueIds"],
      "properties": {
        "competence": {
          "type": "string",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])$"
        },
        "kind": { "enum": ["monthly", "special"] },
        "startsOn": { "$ref": "#/$defs/annotatedDate" },
        "endsOn": { "$ref": "#/$defs/annotatedDate" },
        "timezone": { "const": "America/Sao_Paulo" },
        "issueIds": { "$ref": "#/$defs/issueIds" }
      }
    },
    "publicPriceCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "startsOn", "endsOn", "promotionAction", "existingPriceId", "expectedLockVersion", "issueIds"],
      "properties": {
        "amount": { "$ref": "#/$defs/annotatedMoney" },
        "startsOn": { "$ref": "#/$defs/annotatedDate" },
        "endsOn": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/annotatedDate" }
          ]
        },
        "promotionAction": {
          "enum": ["create_draft", "reuse_existing_published", "blocked"]
        },
        "existingPriceId": { "type": ["integer", "null"], "minimum": 1 },
        "expectedLockVersion": { "type": ["integer", "null"], "minimum": 1 },
        "issueIds": { "$ref": "#/$defs/issueIds" }
      }
    },
    "publicPrice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presence", "candidate", "issueIds"],
      "properties": {
        "presence": { "enum": ["mentioned", "not_mentioned", "ambiguous"] },
        "candidate": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/publicPriceCandidate" }
          ]
        },
        "issueIds": { "$ref": "#/$defs/issueIds" }
      }
    },
    "policyParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "termMonths",
        "customerInterestRateMonthly",
        "downPaymentPercentage",
        "annualRate",
        "coverageYears",
        "offerMonth",
        "maintenanceCount",
        "coverageMonths",
        "coverageKm",
        "voucherType",
        "balloonAmount",
        "firstPaymentOn"
      ],
      "properties": {
        "termMonths": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/annotatedInteger" }] },
        "customerInterestRateMonthly": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/annotatedPercentage" }] },
        "downPaymentPercentage": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/annotatedPercentage" }] },
        "annualRate": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/annotatedPercentage" }] },
        "coverageYears": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/annotatedInteger" }] },
        "offerMonth": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/annotatedInteger" }] },
        "maintenanceCount": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/annotatedInteger" }] },
        "coverageMonths": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/annotatedInteger" }] },
        "coverageKm": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/annotatedInteger" }] },
        "voucherType": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/annotatedString" }] },
        "balloonAmount": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/annotatedMoney" }] },
        "firstPaymentOn": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/annotatedDate" }] }
      }
    },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "expectedLockVersion", "currentStartsOn", "currentEndsOn", "status", "plannedEndsOn"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "expectedLockVersion": { "type": "integer", "minimum": 1 },
        "currentStartsOn": { "type": "string", "format": "date" },
        "currentEndsOn": { "type": ["string", "null"], "format": "date" },
        "status": { "enum": ["draft", "needs_review", "published"] },
        "plannedEndsOn": { "type": "string", "format": "date" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clientPolicyId",
        "sourceLabel",
        "canonicalType",
        "mappingStatus",
        "title",
        "description",
        "startsOn",
        "endsOn",
        "customerBenefitAmount",
        "dealerRebateAmount",
        "parameters",
        "restrictions",
        "promotionAction",
        "existingPolicyId",
        "predecessor",
        "issueIds"
      ],
      "properties": {
        "clientPolicyId": { "$ref": "#/$defs/clientId" },
        "sourceLabel": { "$ref": "#/$defs/annotatedString" },
        "canonicalType": {
          "type": ["string", "null"],
          "enum": [
            "retail_bonus",
            "invoice_discount",
            "trade_in_bonus",
            "loyalty_bonus",
            "subsidized_financing",
            "free_ipva",
            "free_insurance",
            "free_wallbox",
            "free_registration",
            "free_maintenance",
            "fuel_or_recharge_voucher",
            "other",
            null
          ]
        },
        "mappingStatus": { "enum": ["mapped", "unsupported", "operator_excluded"] },
        "title": { "$ref": "#/$defs/annotatedString" },
        "description": { "$ref": "#/$defs/annotatedNullableString" },
        "startsOn": { "$ref": "#/$defs/annotatedDate" },
        "endsOn": { "$ref": "#/$defs/annotatedDate" },
        "customerBenefitAmount": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/annotatedMoney" }]
        },
        "dealerRebateAmount": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/annotatedMoney" }]
        },
        "parameters": { "$ref": "#/$defs/policyParameters" },
        "restrictions": {
          "type": "array",
          "items": { "$ref": "#/$defs/annotatedString" }
        },
        "promotionAction": {
          "enum": ["create_draft", "reuse_existing", "exclude_by_operator", "blocked"]
        },
        "existingPolicyId": { "type": ["integer", "null"], "minimum": 1 },
        "predecessor": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/predecessor" }]
        },
        "issueIds": { "$ref": "#/$defs/issueIds" }
      }
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clientOfferId",
        "label",
        "policyClientIds",
        "sourceRelation",
        "startsOn",
        "endsOn",
        "restrictions",
        "promotionAction",
        "existingOfferId",
        "issueIds"
      ],
      "properties": {
        "clientOfferId": { "$ref": "#/$defs/clientId" },
        "label": { "$ref": "#/$defs/annotatedString" },
        "policyClientIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/clientId" }
        },
        "sourceRelation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "meta"],
          "properties": {
            "value": { "enum": ["and", "or_alternative", "standalone"] },
            "meta": { "$ref": "#/$defs/fieldMeta" }
          }
        },
        "startsOn": { "$ref": "#/$defs/annotatedDate" },
        "endsOn": { "$ref": "#/$defs/annotatedDate" },
        "restrictions": {
          "type": "array",
          "items": { "$ref": "#/$defs/annotatedString" }
        },
        "promotionAction": { "enum": ["create_draft", "reuse_existing", "exclude_by_operator", "blocked"] },
        "existingOfferId": { "type": ["integer", "null"], "minimum": 1 },
        "issueIds": { "$ref": "#/$defs/issueIds" }
      }
    },
    "affectedOffer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offerId", "expectedLockVersion", "status", "currentValidFrom", "currentValidTo", "plannedValidTo"],
      "properties": {
        "offerId": { "type": "integer", "minimum": 1 },
        "expectedLockVersion": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["draft", "published"] },
        "currentValidFrom": { "type": "string", "format": "date" },
        "currentValidTo": { "type": ["string", "null"], "format": "date" },
        "plannedValidTo": { "type": "string", "format": "date" }
      }
    },
    "promotionPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "publishedPriceIdForOffers", "affectedOffers", "requiresExplicitConfirmation", "issueIds"],
      "properties": {
        "mode": {
          "enum": ["single_phase", "two_phase_awaiting_price_publication", "blocked", "nothing_to_promote"]
        },
        "publishedPriceIdForOffers": { "type": ["integer", "null"], "minimum": 1 },
        "affectedOffers": {
          "type": "array",
          "items": { "$ref": "#/$defs/affectedOffer" }
        },
        "requiresExplicitConfirmation": { "const": true },
        "issueIds": { "$ref": "#/$defs/issueIds" }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issueId", "code", "severity", "blocking", "path", "message", "evidence", "status", "resolution"],
      "properties": {
        "issueId": { "$ref": "#/$defs/clientId" },
        "code": {
          "enum": [
            "SOURCE_BLOCK_INCOMPLETE",
            "SOURCE_PRECEDENCE_UNRESOLVED",
            "EVIDENCE_MISSING",
            "EVIDENCE_CONFLICT",
            "CONFIDENCE_LOW",
            "MMV_FIELD_MISSING",
            "MMV_YEAR_AMBIGUOUS",
            "PRODUCT_UNMATCHED",
            "PRODUCT_MATCH_AMBIGUOUS",
            "PRODUCT_MATCH_STALE",
            "PERIOD_MISSING",
            "PERIOD_INVALID",
            "PERIOD_OUTSIDE_COMPETENCE",
            "OPEN_ENDED_PERIOD_UNRESOLVED",
            "MSRP_AMBIGUOUS",
            "MSRP_INVALID",
            "MSRP_CONFLICT",
            "MSRP_LOCK_STALE",
            "MSRP_PUBLICATION_REQUIRED_FOR_OFFER",
            "POLICY_TYPE_UNSUPPORTED",
            "POLICY_VALUE_MISSING",
            "POLICY_PARAMETERS_INCOMPLETE",
            "POLICY_PERIOD_CONFLICT",
            "POLICY_PREDECESSOR_AMBIGUOUS",
            "POLICY_PREDECESSOR_LOCK_STALE",
            "REBATE_UNATTRIBUTED",
            "REBATE_EXCEEDS_BENEFIT",
            "OFFER_RELATION_AMBIGUOUS",
            "OFFER_EMPTY",
            "OFFER_REFERENCES_UNKNOWN_POLICY",
            "OFFER_DUPLICATE_COMPOSITION",
            "OFFER_COVERAGE_GAP",
            "OFFER_CHANNEL_UNSUPPORTED",
            "OFFER_RESTRICTION_UNSUPPORTED",
            "OFFER_PREDECESSOR_AMBIGUOUS",
            "OFFER_PREDECESSOR_LOCK_STALE",
            "RETROACTIVE_PUBLISHED_OFFER_ROLLOVER",
            "OUTPUT_PROVENANCE_UNSUPPORTED",
            "PROMOTION_CONFLICT",
            "OPERATOR_EXCLUSION_REQUIRES_REASON",
            "CHANGES_REQUESTED"
          ]
        },
        "severity": { "enum": ["error", "warning", "info"] },
        "blocking": { "type": "boolean" },
        "path": { "type": "string", "pattern": "^/" },
        "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "status": { "enum": ["open", "resolved", "accepted_risk"] },
        "resolution": { "type": ["string", "null"], "maxLength": 2000 }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockingIssueCount", "warningCount", "readyForApproval", "readyForPromotion"],
      "properties": {
        "blockingIssueCount": { "type": "integer", "minimum": 0 },
        "warningCount": { "type": "integer", "minimum": 0 },
        "readyForApproval": { "type": "boolean" },
        "readyForPromotion": { "type": "boolean" }
      }
    },
    "issueIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/clientId" }
    },
    "clientId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    }
  }
}
