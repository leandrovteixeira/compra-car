# Compra Car — central per-agent model selection (non-secret).
# Copy to C:/Dev/.secrets/compra-car/agent-models.env, or configure in server secrets.
# Keep OPENAI_API_KEY in private staging.env; NEVER commit the credential.
AGENT_BRAND_MODEL=gpt-6-luna
AGENT_MMV_MODEL=gpt-6-luna
AGENT_MODEL_YEAR_MODEL=gpt-6-luna
AGENT_PRICE_MODEL=gpt-6-luna
AGENT_SPEC_MODEL=gpt-6-luna
AGENT_ENGINEERING_MODEL=gpt-6-luna
AGENT_WATCHER_MODEL=gpt-6-luna
# Explicit opt-in pilot. Never run during collection or routine polling.
AGENT_WATCHER_AI_ENABLED=false
AGENT_WATCHER_AI_MAX_ARTICLES=20
AGENT_WATCHER_AI_HARD_COST_CAP_USD=0.25
