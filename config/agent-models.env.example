# Seleção centralizada de modelos por agente (sem chaves de API).
# Campos vazios preservam o modelo já configurado nos agentes existentes.
# Copie para C:/Dev/.secrets/compra-car/agent-models.env (nunca versione o arquivo real).
AGENT_BRAND_MODEL=
AGENT_MMV_MODEL=
AGENT_MODEL_YEAR_MODEL=
AGENT_PRICE_MODEL=
AGENT_SPEC_MODEL=
AGENT_ENGINEERING_MODEL=
AGENT_WATCHER_MODEL=gpt-5.4-mini
AGENT_WATCHER_AI_ENABLED=false
AGENT_WATCHER_AI_MAX_ARTICLES=20
AGENT_WATCHER_AI_HARD_COST_CAP_USD=0.25
